name: youtube-transcripts
on:
  workflow_dispatch: {}
permissions:
  contents: write
jobs:
  run:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    strategy:
      fail-fast: false
      matrix:
        shard: [0, 1, 2, 3, 4]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.12" }
      - run: pip install yt-dlp
      - run: python youtube-curation/yt_pick.py
        env:
          SHARD: ${{ matrix.shard }}
          NSHARDS: "5"
      - name: commit results
        run: |
          git config user.name robot; git config user.email robot@users.noreply.github.com
          git add youtube-curation/out
          git commit -m "youtube transcripts shard ${{ matrix.shard }}" || exit 0
          for i in 1 2 3 4 5; do git pull --rebase -q && git push -q && break; sleep $((RANDOM%10+3)); done
